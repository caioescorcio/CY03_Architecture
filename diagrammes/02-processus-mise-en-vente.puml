@startuml 02-processus-mise-en-vente
title Processus structurant : mise en vente critique (§2.1)
skinparam defaultFontName Liberation Sans

|Spectateur|
start
:Arrive à l'ouverture;
|BilletLive|
:Place l'acheteur dans la file\n(ordre d'arrivée);
while (Son tour ?) is (non)
  |Spectateur|
  :Reçoit sa position dans la file;
  |BilletLive|
endwhile (oui)
|Spectateur|
:Choisit sa place;
|BilletLive|
:Bloque la place\npour une durée limitée;
|Spectateur|
:Paie;
|Prestataire de paiement|
:Authentification forte\net autorisation;
|BilletLive|
if (Paiement confirmé dans le délai ?) then (oui)
  :Vend la place\német le titre;
  |Spectateur|
  :Reçoit son billet;
  stop
else (non : refus ou délai expiré)
  |BilletLive|
  :Libère la place\nretour au stock;
  stop
endif
@enduml
